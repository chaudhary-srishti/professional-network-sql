# Copy to .env (or export in your shell). Matches the docker-compose Postgres on host port 5433.
DATABASE_URL=postgresql://professional_network:professional_network@localhost:5433/professional_network

# Used only by the test suite; created/migrated separately (see tests/conftest.py).
TEST_DATABASE_URL=postgresql://professional_network:professional_network@localhost:5433/professional_network_test
